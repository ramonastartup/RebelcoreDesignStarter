{
  "color": {
    "$type": "color",
    "deep-sapphire": {
      "$value": { "colorSpace": "srgb", "components": [0.0902, 0.2275, 0.4196], "alpha": 1, "hex": "#173A6B" }
    },
    "dark-red": {
      "$value": { "colorSpace": "srgb", "components": [0.5569, 0.051, 0.1333], "alpha": 1, "hex": "#8E0D22" }
    },
    "pale-blue": {
      "$value": { "colorSpace": "srgb", "components": [0.9176, 0.9451, 1], "alpha": 1, "hex": "#EAF1FF" }
    }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 8, "unit": "px" } }
  },
  "spacing": {
    "$type": "dimension",
    "14": { "$value": { "value": 14, "unit": "px" } },
    "15": { "$value": { "value": 15, "unit": "px" } },
    "34": { "$value": { "value": 34, "unit": "px" } }
  },
  "sizing": {
    "$type": "dimension",
    "size-56": { "$value": { "value": 56, "unit": "px" } },
    "size-28": { "$value": { "value": 28, "unit": "px" } }
  },
  "typography": {
    "font-family": {
      "inter": { "$type": "fontFamily", "$value": "Inter" }
    },
    "font-weight": {
      "600": { "$type": "fontWeight", "$value": 600 }
    },
    "font-size": {
      "18": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } }
    },
    "line-height": {
      "120-percent": { "$type": "number", "$value": 1.2 }
    },
    "letter-spacing": {
      "4-percent": { "$type": "dimension", "$value": { "value": 0.72, "unit": "px" } }
    }
  },
  "motion": {
    "duration": {
      "160ms": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } }
    },
    "easing": {
      "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.58, 1] }
    }
  },
  "elevation": {
    "$type": "shadow",
    "md": {
      "$description": "Button elevation",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.35, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 7, "unit": "px" },
        "blur": { "value": 14, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "button": {
    "primary": {
      "default": { "$type": "color", "$value": "{color.deep-sapphire}" },
      "hover": { "$type": "color", "$value": "{color.dark-red}" },
      "text": { "$type": "color", "$value": "{color.pale-blue}" }
    },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "spacing": {
      "icon": {
        "padding-y": { "$type": "dimension", "$value": "{spacing.14}" },
        "padding-x": { "$type": "dimension", "$value": "{spacing.15}" }
      },
      "label": {
        "padding-left": { "$type": "dimension", "$value": "{spacing.14}" },
        "padding-right": { "$type": "dimension", "$value": "{spacing.34}" }
      }
    },
    "typography": {
      "font-family": { "$type": "fontFamily", "$value": "{typography.font-family.inter}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.600}" },
      "font-size": { "$type": "dimension", "$value": "{typography.font-size.18}" },
      "line-height": { "$type": "number", "$value": "{typography.line-height.120-percent}" },
      "letter-spacing": { "$type": "dimension", "$value": "{typography.letter-spacing.4-percent}" }
    },
    "size": {
      "md": {
        "height": { "$type": "dimension", "$value": "{sizing.size-56}" },
        "icon": { "$type": "dimension", "$value": "{sizing.size-28}" }
      }
    },
    "icon": {
      "color": { "$type": "color", "$value": "{color.pale-blue}" }
    }
  }
}